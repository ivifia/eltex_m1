"observer.sh" 12L, 325B  zz           #!/bin/bashCONFIG="observer.conf"LOG="observer.log"

while read -r script; do
    [[ -z "$script" || "$script" =~ ^# ]] && continue
    if ! pgrep -f "$script" > /dev/null; thenecho "$(date '+%Y-%m-%d %H:%M:%S')  $script" >> "$LOG"nohup ./"$script" > /dev/null 2>&1 &
    fi
done < "$CONFIG"
