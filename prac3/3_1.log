"observer.sh" 12L, 302B  zz           #!/bin/bashCONFIG="observer.conf"LOG="observer.log"

while read -r script; do
    [[ -z "$script" || "$script" =~ ^# ]] && continue
    if ! pgrep -f "$script" > /dev/null; thenecho "$(date '+%Y-%m-%d %H:%M:%S')  $script" >> "$LOG"./"$script" &
    fi
done < "$CONFIG"
