     47 root       0 -20       0      0      0 I   0.0   0.0   0:00.00 kworker/R-edac-                                                                                                       #!/bin/bash

CONFIG="observer.conf"
LOG="observer.log"

while read -r script; do
    [[ -z "$script" || "$script" =~ ^# ]] && continue
    if ! pgrep -x "$script" > /dev/null; then
        echo "$(date '+%Y-%m-%d %H:%M:%S')  $script" >> "$LOG"
        nohup ./"$script" > /dev/null 2>&1 &
    fi
done < "$CONFIG"
EOF
