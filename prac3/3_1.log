"cuckoo.sh" 27L, 647B  zz           #!/bin/bashmkdir -p /tmp/runif [[ ! -p /tmp/run/cuckoo.pid ]]; then
    mkfifo /tmp/run/cuckoo.pid
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') Startup!" >> /root/cuckoo.log

shutdown() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') Shutdown!" >> /root/cuckoo.log
    exit 0
}

trap shutdown TERM

while read -r message; do
    if [[ "$message" =~ ^([A-Za-z0-9_]+)\[([0-9]+)\]:\ how\ much\ time\ do\ I\ have\?$ ]]; thenNAME="${BASH_REMATCH[1]}"PID="${BASH_REMATCH[2]}"N=$((RANDOM % 9 + 2))echo "$(date '+%Y-%m-%d %H:%M:%S') ${NAME}[${PID}] ${N}" >> /root/cuckoo.logecho "$N"
    fi
done < /tmp/run/cuckoo.pid
