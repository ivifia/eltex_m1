"observer.sh" 13L, 329B  zz           #!/bin/bashCONFIG="observer.conf"LOG="observer.log"

while read -r script; do
    [[ -z "$script" || "$script" =~ ^# ]] && continue
    if ! pgrep -x "$script" > /dev/null; thenecho "$(date '+%Y-%m-%d %H:%M:%S')  $script" >> "$LOG"nohup ./"$script" > /dev/null 2>&1 &
    fi
done < "$CONFIG"
EOF
