"template_task.sh" 20L, 718B  zz           #!/bin/bashif [[ "$(basename "$0")" == "template_task.sh" ]]; thenecho " ,   "
    exit 1
fi

script_name=$(basename "$0")
echo "$(date '+%Y-%m-%d %H:%M:%S') [$$]  " >> "report_${script_name}.log"


echo "${script_name}[$$]: how much time do I have?" > /tmp/run/cuckoo.pid
read N < /tmp/run/cuckoo.pid

if [[ "$N" =~ ^[0-9]+$ ]]; then
    sleep "$N"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$$]  ,  ${N} ." >> "report_${script_name}.log"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$$] :    '${N}'" >> "report_${script_name}.log"
fi
